# Copy to docker/.env, protect it with chmod 600, and set independent secrets.
# Generate each secret with: openssl rand -hex 32
API_KEY=
WEB_PASSWORD=
PORT=8045
LOG_LEVEL=info
ABV_MAX_BODY_SIZE=104857600

# Persistent accounts and configuration (default: ~/.antigravity_tools).
# ABV_HOST_DATA_DIR=/absolute/path/to/antigravity-data

# Optional outbound proxy. This is distinct from the API gateway's listen URL.
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
